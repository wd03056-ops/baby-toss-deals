# 토스쇼핑 쉐어링크 Open API
# 크리에이터 어드민(sharelink.toss.im)에서 Access Key / Secret Key 발급

TOSS_ACCESS_KEY=your_access_key
TOSS_SECRET_KEY=your_secret_key

# 쉐어링크 실시간 발급용 퍼블리셔 UUID (필수)
TOSS_PUBLISHER_ID=your_publisher_uuid

# (선택) 카테고리 자동 탐색 실패 시 사용할 출산/유아동 카테고리 ID
# TOSS_BABY_CATEGORY_ID=

# (선택) 앱인토스 콘솔 배너 광고 그룹 ID (리스트형)
# 미설정 시 테스트 ID 사용
# 리스트형: ait-ad-test-banner-id
# 피드형(미사용): ait-ad-test-native-image-id
# NEXT_PUBLIC_TOSS_ADS_BANNER_ID=
